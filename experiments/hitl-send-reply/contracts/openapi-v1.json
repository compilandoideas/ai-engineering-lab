{
  "openapi": "3.1.1",
  "info": {
    "title": "HitlSendReply.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/inbound-emails": {
      "post": {
        "tags": [
          "Inbound"
        ],
        "operationId": "ReceiveInboundEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundEmailResult"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundEmailResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}": {
      "get": {
        "tags": [
          "Runs"
        ],
        "operationId": "GetRun",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/runs/{runId}/reviews/{callId}": {
      "post": {
        "tags": [
          "Runs"
        ],
        "operationId": "ReviewRun",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "callId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/tickets": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "ListTickets",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InboundEmailRequest": {
        "required": [
          "emailId",
          "from",
          "subject",
          "body",
          "receivedAt"
        ],
        "type": "object",
        "properties": {
          "emailId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InboundEmailResult": {
        "required": [
          "status",
          "runId",
          "ticketId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/InboundEmailStatus"
          },
          "runId": {
            "type": [
              "null",
              "string"
            ]
          },
          "ticketId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "InboundEmailStatus": {
        "enum": [
          "Started",
          "Unmatched",
          "Duplicate"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReviewRequest": {
        "required": [
          "approved",
          "reason",
          "reviewer"
        ],
        "type": "object",
        "properties": {
          "approved": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "reviewer": {
            "type": "string"
          },
          "editedText": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Inbound"
    },
    {
      "name": "Runs"
    },
    {
      "name": "Catalog"
    }
  ]
}