<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The Agent API: endpoints and composition only. Hosts the system behind an HTTP contract and
       knows nothing about the UI.
       A Python port (FastAPI) replaces this project and implements contracts/openapi-v1.json. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi-v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HitlSendReply.Infrastructure\HitlSendReply.Infrastructure.csproj" />
    <ProjectReference Include="..\HitlSendReply.Presentation\HitlSendReply.Presentation.csproj" />
    <ProjectReference Include="..\HitlSendReply.Contracts\HitlSendReply.Contracts.csproj" />
    <ProjectReference Include="..\..\..\HitlSendReply.ServiceDefaults\HitlSendReply.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HitlSendReply.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="HitlSendReply.Presentation.Endpoints" />
  </ItemGroup>
</Project>
