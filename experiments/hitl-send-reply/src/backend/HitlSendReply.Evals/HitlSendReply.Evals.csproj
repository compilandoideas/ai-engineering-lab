<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measures the real judge through the full policy on labeled drafts. Batch, no UI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HitlSendReply\HitlSendReply.csproj" />
    <!-- For the in-memory adapters, sample tickets and model settings the API already owns. -->
    <ProjectReference Include="..\HitlSendReply.Api\HitlSendReply.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The labeled drafts live in eval/datasets: drafts.<lang> (development) and blind.<lang> (never used to tune). -->
    <None Include="..\..\..\eval\datasets\*.jsonl" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HitlSendReply.Tests" />
  </ItemGroup>
</Project>
