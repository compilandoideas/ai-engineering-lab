@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <MudText Typo="Typo.h6" Class="mr-6 d-none d-sm-flex">HITL send_reply</MudText>
        <MudNavLink Href="" Match="NavLinkMatch.All" Class="top-link" data-testid="nav-review">@Text.NavReview</MudNavLink>
        <MudNavLink Href="inbox" Class="top-link" data-testid="nav-inbox">@Text.NavInbox</MudNavLink>
        <MudSpacer />
        <MudToggleGroup T="string" @bind-Value="_lang" Size="Size.Small" Outlined="true" data-testid="lang">
            <MudToggleItem Value="@("en")" Text="EN" />
            <MudToggleItem Value="@("es")" Text="ES" />
        </MudToggleGroup>
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       aria-label="@Text.DarkMode" data-testid="theme" OnClick="() => _dark = !_dark" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <CascadingValue Value="Text">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Quiet chrome: the app bar is the page surface, color is kept for the outcome and the main action.
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight { AppbarBackground = "#ffffff", AppbarText = "rgba(0,0,0,0.87)" },
        PaletteDark = new PaletteDark { AppbarBackground = "#27272f", AppbarText = "rgba(255,255,255,0.80)" },
    };

    private bool _dark;
    private string _lang = "en";

    private Labels Text => _lang == "es" ? Labels.Es : Labels.En;
}
