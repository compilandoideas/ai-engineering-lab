@* Writes a simulated inbound email, as a customer would, in the same composer as a reply. To is
   fixed: everything goes to the support inbox. From suggests the sample customers, but any address
   can be typed. *@
@inject AgentApiClient Api

<MudDialog data-testid="compose-dialog" Class="compose-dialog" TitleClass="compose-title" ContentClass="compose-content" ActionsClass="compose-actions">
    <TitleContent>@Text.Compose</TitleContent>
    <DialogContent>
        <div class="mail-composer flat">
            <div class="composer-row">
                <span class="composer-label">@Text.From:</span>
                <MudAutocomplete T="string" @bind-Value="_from" Variant="Variant.Text" Underline="false" Placeholder="customer@example.com"
                                 SearchFunc="SearchCustomersAsync" CoerceValue="true" CoerceText="false" Margin="Margin.Dense"
                                 Immediate="true" Class="composer-field" data-testid="compose-from" />
            </div>
            <div class="composer-row">
                <span class="composer-label">@Text.ToLabel:</span>
                <span class="composer-chip">@Client.Mailbox.Mailbox.SupportAddress</span>
            </div>
            <div class="composer-row">
                <span class="composer-label">@Text.Subject:</span>
                <MudTextField T="string" @bind-Value="_subject" Variant="Variant.Text" Underline="false" Margin="Margin.Dense" Immediate="true"
                              Class="composer-field" data-testid="compose-subject" />
            </div>
            <div class="composer-body">
                <MudTextField T="string" @bind-Value="_body" Variant="Variant.Text" Underline="false" Lines="7" Immediate="true"
                              Placeholder="@Text.Body" Class="composer-input" data-testid="compose-body" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send" Class="primary-btn"
                   Disabled="!CanSend" OnClick="Send" data-testid="compose-send">@Text.Send</MudButton>
        <MudButton Variant="Variant.Outlined" Class="ghost-btn" OnClick="() => Dialog.Cancel()">@Text.Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public Labels Text { get; set; } = Labels.En;

    private string? _from;
    private string? _subject;
    private string? _body;
    private IReadOnlyList<string> _customers = [];

    private bool CanSend => !string.IsNullOrWhiteSpace(_from) && !string.IsNullOrWhiteSpace(_subject) && !string.IsNullOrWhiteSpace(_body);

    protected override async Task OnInitializedAsync()
    {
        var english = await Api.ListTicketsAsync("en");
        var spanish = await Api.ListTicketsAsync("es");
        _customers = english.Concat(spanish).Select(t => t.CustomerAddress).Where(a => a.Contains('@')).Distinct().ToList();
    }

    private Task<IEnumerable<string>> SearchCustomersAsync(string? value, CancellationToken cancellationToken) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? _customers.AsEnumerable()
            : _customers.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void Send() => Dialog.Close(DialogResult.Ok(new ComposeEmailRequest(_from!, _subject!, _body!)));
}
