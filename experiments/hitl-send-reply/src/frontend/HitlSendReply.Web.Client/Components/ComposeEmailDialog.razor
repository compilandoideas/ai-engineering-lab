@* Writes a simulated inbound email, as a customer would. To is fixed: everything goes to the
   support inbox. From suggests the sample customers, but any address can be typed. *@
@inject AgentApiClient Api

<MudDialog data-testid="compose-dialog">
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: min(560px, 80vw)">
            <MudAutocomplete T="string" @bind-Value="_from" Label="@Text.From" Variant="Variant.Outlined"
                             SearchFunc="SearchCustomersAsync" CoerceValue="true" CoerceText="false"
                             Immediate="true" data-testid="compose-from" />
            <MudTextField T="string" Value="@Client.Mailbox.Mailbox.SupportAddress" Label="@Text.To" Variant="Variant.Outlined" ReadOnly="true" />
            <MudTextField T="string" @bind-Value="_subject" Label="@Text.Subject" Variant="Variant.Outlined" Immediate="true" data-testid="compose-subject" />
            <MudTextField T="string" @bind-Value="_body" Label="@Text.Body" Variant="Variant.Outlined" Lines="8" Immediate="true" data-testid="compose-body" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@Text.Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                   Disabled="!CanSend" OnClick="Send" data-testid="compose-send">@Text.Send</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public Labels Text { get; set; } = Labels.En;

    private string? _from;
    private string? _subject;
    private string? _body;
    private IReadOnlyList<string> _customers = [];

    private bool CanSend => !string.IsNullOrWhiteSpace(_from) && !string.IsNullOrWhiteSpace(_subject) && !string.IsNullOrWhiteSpace(_body);

    protected override async Task OnInitializedAsync()
    {
        var english = await Api.ListTicketsAsync("en");
        var spanish = await Api.ListTicketsAsync("es");
        _customers = english.Concat(spanish).Select(t => t.CustomerAddress).Where(a => a.Contains('@')).Distinct().ToList();
    }

    private Task<IEnumerable<string>> SearchCustomersAsync(string? value, CancellationToken cancellationToken) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? _customers.AsEnumerable()
            : _customers.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void Send() => Dialog.Close(DialogResult.Ok(new ComposeEmailRequest(_from!, _subject!, _body!)));
}
