<MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(Lost ? Color.Default : ColorOf(Status))"
         data-testid="email-status" data-status="@Status">@(Lost ? Text.RunLost : Text.Name(Status))</MudChip>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter, EditorRequired] public EmailStatus Status { get; set; }

    /// <summary>The run is gone (the Agent API restarted): the status is the last one known.</summary>
    [Parameter] public bool Lost { get; set; }

    private static Color ColorOf(EmailStatus status) => status switch
    {
        EmailStatus.Sent => Color.Success,
        EmailStatus.AwaitingReview => Color.Warning,
        EmailStatus.NotifyFailed or EmailStatus.Blocked or EmailStatus.RunFailed => Color.Error,
        EmailStatus.Unmatched => Color.Default,
        _ => Color.Info,
    };
}
