@* The email's status as a quiet badge in the reader's toolbar: a colored dot and gray text. *@

<span class="mail-badge" data-testid="email-status" data-status="@Status">
    <span class="@($"mail-badge-dot {ToneOf(Status)}")"></span>@(Lost ? Text.RunLost : Text.Name(Status))
</span>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter, EditorRequired] public EmailStatus Status { get; set; }

    /// <summary>The run is gone (the Agent API restarted): the status is the last one known.</summary>
    [Parameter] public bool Lost { get; set; }

    private string ToneOf(EmailStatus status) => Lost ? "muted" : status switch
    {
        EmailStatus.Sent => "ok",
        EmailStatus.AwaitingReview => "wait",
        EmailStatus.NotifyFailed or EmailStatus.RunFailed => "bad",
        EmailStatus.Blocked or EmailStatus.Unmatched => "muted",
        _ => "busy",
    };
}
