@* The end of a run: what reached the customer, to whom and on which channel, or why nothing did. *@

<MudText Typo="Typo.overline">@Text.Result</MudText>
<div data-testid="result">
    @if (Run.Sent.Count > 0)
    {
        @foreach (var sent in Run.Sent)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                @Text.Sent → <b>@sent.Recipient</b> (@sent.Channel)
            </MudAlert>
            <MudText Typo="Typo.body2" Class="draft-text mb-2">@sent.Text</MudText>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@Text.NotSent @WhyNotSent</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(Run.AgentReply))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Text.AgentReply</MudText>
        <MudText Typo="Typo.body2" Class="draft-text">@Run.AgentReply</MudText>
    }
</div>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter, EditorRequired] public RunDto Run { get; set; } = default!;

    private string? WhyNotSent => Run.Audit.LastOrDefault(e => e.Event is "human-rejected" || e.Outcome is "Block")?.Reason;
}
