@* Under the open email: what the policy decided and the agent's draft in the reply composer, with
   the three actions while it waits for a person. Reads the run from the Agent API through the Web server. *@
@implements IAsyncDisposable
@inject AgentApiClient Api

<div data-testid="mail-reply" class="mail-reply">
    @if (_error is not null)
    {
        <div class="mail-notice error" data-testid="error"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" /><span>@_error</span></div>
    }

    @if (_run is null || _run.Status == RunStatus.Starting)
    {
        <div class="mail-notice" data-testid="starting">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Style="width: 14px; height: 14px" />
            <span>@Text.Starting</span>
        </div>
    }
    else if (_run.Status == RunStatus.Failed)
    {
        <div class="mail-notice error" data-testid="failed"><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" /><span>@Text.RunFailed @_run.Error</span></div>
    }
    else
    {
        @* One line on why the reply is where it is: the judge's or the rule's reason, and what is asked of the person. *@
        <div class="@($"mail-notice {Tone}")" data-testid="summary">
            <MudIcon Icon="@ToneIcon" Size="Size.Small" />
            <span class="flex-grow-1">@Text.Summary(_run)</span>
            <button type="button" class="notice-link" aria-expanded="@ShowTrace.ToString().ToLowerInvariant()" @onclick="ToggleTraceAsync"
                    data-testid="why-toggle">@(ShowTrace ? Text.HideDetails : Text.Details)</button>
        </div>

        @* The policy's trace and the run's audit, opened from the notice or from the eye in the toolbar. *@
        @if (ShowTrace)
        {
            <div class="mail-trace" data-testid="why">
                @if (LastDecision is { } decision)
                {
                    <DecisionTrace Decision="decision" />
                }
                <div class="mt-4">
                    <AuditTimeline Entries="@(_run?.Audit ?? [])" />
                </div>
            </div>
        }

        @* Waiting: the draft sits in the reply composer. Decided: the reply is the next message of the thread. *@
        @if (Pending is { } review)
        {
            <ReviewPanel Review="review" Subject="@Subject" Busy="_busy" OnReview="ReviewAsync" />
        }
        else
        {
            <span data-testid="result" hidden></span>
            @if (Draft is not null)
            {
                <div class="mail-message" data-testid="sent-message">
                    <div class="mail-head">
                        <span class="mail-avatar support"><MudIcon Icon="@Icons.Material.Outlined.SupportAgent" Style="font-size: 18px" /></span>
                        <div class="mail-head-text">
                            <div><span class="mail-head-name">@Text.SupportName</span> <span class="mail-head-address">· @(_run?.Sent.Count > 0 ? Text.ReplySent : Text.AgentAnswer)</span></div>
                            @if (Recipient is { } to)
                            {
                                <div class="mail-head-to">@Text.ToLabel: @to</div>
                            }
                        </div>
                        @if (_run?.Sent.LastOrDefault() is { } sent)
                        {
                            <span class="mail-head-time">@Senders.Stamp(sent.SentAt, Text.Code)</span>
                        }
                    </div>
                    <div class="mail-body reply">
                        <p class="draft-text" data-testid="draft">@Draft</p>
                    </div>
                </div>
            }
        }

    }
</div>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter, EditorRequired] public string RunId { get; set; } = "";

    /// <summary>The subject of the customer's email, shown as "Re: …" in the composer.</summary>
    [Parameter] public string Subject { get; set; } = "";

    /// <summary>Whether the policy's trace and the audit are open under the notice.</summary>
    [Parameter] public bool ShowTrace { get; set; }

    [Parameter] public EventCallback<bool> ShowTraceChanged { get; set; }

    /// <summary>Raised after a decision, so the list can show the new status at once.</summary>
    [Parameter] public EventCallback OnDecided { get; set; }

    private RunDto? _run;
    private string? _loaded;
    private string? _error;
    private string? _lastReviewed;
    private bool _busy;
    private readonly CancellationTokenSource _stop = new();

    private PendingReviewDto? Pending => _run?.PendingReviews.FirstOrDefault();

    private string? Draft => Pending?.Text ?? _run?.Sent.LastOrDefault()?.Text ?? _lastReviewed;

    private string? Recipient => Pending?.Recipient ?? _run?.Sent.LastOrDefault()?.Recipient;

    private string Tone => Pending is not null ? "wait" : _run?.Sent.Count > 0 ? "ok" : "bad";

    private string ToneIcon => Pending is not null ? Icons.Material.Outlined.Gavel
        : _run?.Sent.Count > 0 ? Icons.Material.Outlined.TaskAlt : Icons.Material.Outlined.Block;

    private DecisionDto? LastDecision => Pending?.Decision ?? (_run?.Audit.LastOrDefault(e => e.Event == "policy-decision") is { } e
        ? new DecisionDto(e.Outcome ?? "", e.Stage ?? "", e.Reason ?? "")
        : null);

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == RunId)
        {
            return;
        }

        _loaded = RunId;
        _run = null;
        _error = null;
        _lastReviewed = null;
        await LoadAsync();

        // A run from an email may still be drafting: read it again until the agent is done.
        for (var i = 0; i < 120 && _loaded == RunId && _run is null or { Status: RunStatus.Starting } && !_stop.IsCancellationRequested; i++)
        {
            StateHasChanged();
            await Task.Delay(1000);
            await LoadAsync();
        }
    }

    private Task ToggleTraceAsync() => ShowTraceChanged.InvokeAsync(!ShowTrace);

    private async Task LoadAsync()
    {
        try
        {
            var result = await Api.GetRunAsync(RunId);
            _run = result.Value ?? _run;
            _error = result.Error;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReviewAsync((string CallId, ReviewRequest Review) review)
    {
        _busy = true;
        _error = null;
        try
        {
            var reviewed = Pending?.Text;
            var result = await Api.ReviewAsync(RunId, review.CallId, review.Review);
            if (result.Value is not null)
            {
                _lastReviewed = reviewed;
                _run = result.Value;
            }

            _error = result.Status == 422 ? $"{Text.EditRefused} {result.Error}" : result.Error;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            await OnDecided.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _stop.Dispose();
    }
}
