@* Under the open email: what the policy decided and the agent's draft in the reply composer, with
   the three actions while it waits for a person. Reads the run from the Agent API through the Web server. *@
@implements IAsyncDisposable
@inject AgentApiClient Api

<div data-testid="mail-reply">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="error">@_error</MudAlert>
    }

    @if (_run is null || _run.Status == RunStatus.Starting)
    {
        <MudAlert Severity="Severity.Info" Dense="true" data-testid="starting">@Text.Starting</MudAlert>
    }
    else if (_run.Status == RunStatus.Failed)
    {
        <MudAlert Severity="Severity.Error" Dense="true" data-testid="failed">@Text.RunFailed @_run.Error</MudAlert>
    }
    else
    {
        <MudAlert Severity="@Severity" Dense="true" Class="mb-3" data-testid="summary">@Text.Summary(_run)</MudAlert>

        @* Waiting: the draft sits in the reply composer. Decided: the reply is the next message of the thread. *@
        @if (Pending is { } review)
        {
            <ReviewPanel Review="review" Subject="@Subject" Busy="_busy" OnReview="ReviewAsync" />
        }
        else
        {
            <span data-testid="result" hidden></span>
            @if (Draft is not null)
            {
                <div class="mail-message" data-testid="sent-message">
                    <div class="d-flex align-center gap-3 mb-3">
                        <MudAvatar Size="Size.Medium" Color="Color.Primary"><MudIcon Icon="@Icons.Material.Filled.SupportAgent" /></MudAvatar>
                        <div class="flex-grow-1 mail-ellipsis">
                            <MudText Typo="Typo.body2"><b>@Text.SupportName</b> · @(_run.Sent.Count > 0 ? Text.ReplySent : Text.AgentAnswer)</MudText>
                            @if (Recipient is { } to)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Text.ToLabel: @to</MudText>
                            }
                        </div>
                        @if (_run.Sent.LastOrDefault() is { } sent)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@sent.SentAt.ToLocalTime().ToString("HH:mm")</MudText>
                        }
                    </div>
                    <div class="mail-body">
                        <MudText Typo="Typo.body1" Class="draft-text" data-testid="draft">@Draft</MudText>
                    </div>
                </div>
            }
        }

        <MudExpansionPanels Outlined="true" Elevation="0" Class="mt-4">
            <MudExpansionPanel Text="@Text.WhyItStopped" data-testid="why">
                @if (LastDecision is { } decision)
                {
                    <DecisionTrace Decision="decision" />
                }
                <div class="mt-4">
                    @* Rendered later by the panel: by then the run may be reloading. *@
                    <AuditTimeline Entries="@(_run?.Audit ?? [])" />
                </div>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
</div>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter, EditorRequired] public string RunId { get; set; } = "";

    /// <summary>The subject of the customer's email, shown as "Re: …" in the composer.</summary>
    [Parameter] public string Subject { get; set; } = "";

    /// <summary>Raised after a decision, so the list can show the new status at once.</summary>
    [Parameter] public EventCallback OnDecided { get; set; }

    private RunDto? _run;
    private string? _loaded;
    private string? _error;
    private string? _lastReviewed;
    private bool _busy;
    private readonly CancellationTokenSource _stop = new();

    private PendingReviewDto? Pending => _run?.PendingReviews.FirstOrDefault();

    private string? Draft => Pending?.Text ?? _run?.Sent.LastOrDefault()?.Text ?? _lastReviewed;

    private string? Recipient => Pending?.Recipient ?? _run?.Sent.LastOrDefault()?.Recipient;

    private Severity Severity => Pending is not null ? Severity.Warning : _run?.Sent.Count > 0 ? Severity.Success : Severity.Error;

    private DecisionDto? LastDecision => Pending?.Decision ?? (_run?.Audit.LastOrDefault(e => e.Event == "policy-decision") is { } e
        ? new DecisionDto(e.Outcome ?? "", e.Stage ?? "", e.Reason ?? "")
        : null);

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == RunId)
        {
            return;
        }

        _loaded = RunId;
        _run = null;
        _error = null;
        _lastReviewed = null;
        await LoadAsync();

        // A run from an email may still be drafting: read it again until the agent is done.
        for (var i = 0; i < 120 && _loaded == RunId && _run is null or { Status: RunStatus.Starting } && !_stop.IsCancellationRequested; i++)
        {
            StateHasChanged();
            await Task.Delay(1000);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Api.GetRunAsync(RunId);
            _run = result.Value ?? _run;
            _error = result.Error;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReviewAsync((string CallId, ReviewRequest Review) review)
    {
        _busy = true;
        _error = null;
        try
        {
            var reviewed = Pending?.Text;
            var result = await Api.ReviewAsync(RunId, review.CallId, review.Review);
            if (result.Value is not null)
            {
                _lastReviewed = reviewed;
                _run = result.Value;
            }

            _error = result.Status == 422 ? $"{Text.EditRefused} {result.Error}" : result.Error;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            await OnDecided.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _stop.Dispose();
    }
}
