@* Every step the run recorded, in order: what the policy decided, what a person said, what was sent. *@

<MudText Typo="Typo.overline">@Text.Audit</MudText>
<MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start" data-testid="audit">
    @foreach (var entry in Entries)
    {
        <MudTimelineItem Color="ColorOf(entry)" Size="Size.Small">
            <div class="d-flex flex-wrap align-center gap-2">
                <MudText Typo="Typo.body2" data-event="@entry.Event"><b>@Text.Name(entry.Event)</b></MudText>
                @if (entry.Outcome is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Outcomes.ColorOf(entry.Outcome)">@Text.Name(entry.Outcome) · @Text.Name(entry.Stage)</MudChip>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@entry.At.ToLocalTime().ToString("HH:mm:ss") · @entry.Actor · #@Short(entry.TextHash)</MudText>
            </div>
            @if (!string.IsNullOrEmpty(entry.Reason))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Text.Reason(entry.Reason)</MudText>
            }
            @if (entry.Recipient is not null)
            {
                <MudText Typo="Typo.caption">→ @entry.Recipient (@entry.Channel)</MudText>
            }
        </MudTimelineItem>
    }
</MudTimeline>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter, EditorRequired] public IReadOnlyList<AuditEntryDto> Entries { get; set; } = [];

    private static Color ColorOf(AuditEntryDto entry) => entry.Event switch
    {
        "sent" => Color.Success,
        "human-approved" or "human-edited" => Color.Primary,
        "human-rejected" or "send-refused" => Color.Error,
        "send-duplicate" => Color.Default,
        _ => Outcomes.ColorOf(entry.Outcome),
    };

    private static string Short(string hash) => hash.Length > 8 ? hash[..8] : hash;
}
