@page "/"
@page "/inbox"
@page "/inbox/{EmailId:guid}"
@implements IAsyncDisposable
@inject MailboxClient Mailbox
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Text.InboxTitle</PageTitle>

@* Laid out like a mail client: the sidebar with the categories, the list, and the open email with
   the agent's draft in the reply composer under it. On a phone the list and the email take turns. *@
<div class="@($"mail-shell {(_sidebar ? "" : "no-sidebar")}")">
    @* The sidebar: who answers, the main action and the categories with their counts. On a phone it
       folds into a bar on top. *@
    <aside class="mail-sidebar" data-testid="sidebar">
        <div class="side-user">
            <span class="mail-avatar support"><MudIcon Icon="@Icons.Material.Outlined.SupportAgent" Style="font-size: 17px" /></span>
            <div class="side-user-text">
                <div class="side-user-name">@Text.SupportName</div>
                <div class="side-user-mail">@Client.Mailbox.Mailbox.SupportAddress</div>
            </div>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.EditNote" Class="primary-btn side-compose"
                   Disabled="_sending" OnClick="ComposeAsync" aria-label="@Text.Compose" data-testid="compose"><span class="side-compose-text">@Text.Compose</span></MudButton>
        <nav class="side-nav">
            <div class="side-label">@Text.MailSection</div>
            @foreach (var folder in Enum.GetValues<MailFolder>())
            {
                <a href="@FolderHref(folder)" class="@($"side-item {(folder == Folder ? "on" : "")}")" data-testid="side-folder" data-folder="@folder">
                    <MudIcon Icon="@FolderIcon(folder)" Style="font-size: 18px" />
                    <span class="flex-grow-1">@Text.Folder(folder)</span>
                    <span class="side-count">@Count(folder)</span>
                </a>
            }
        </nav>
        <div class="side-foot">
            <a class="side-item" href="https://github.com/compilandoideas/ai-engineering-lab/tree/main/experiments/hitl-send-reply" target="_blank" rel="noopener">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Style="font-size: 18px" />
                <span class="flex-grow-1">@Text.SourceCode</span>
            </a>
            <ShellToggles />
        </div>
    </aside>

    <section class="@($"mail-panel mail-list {(Selected is null ? "" : "mail-hide-phone")}")" data-testid="inbox">
        <div class="mail-toolbar">
            <MudIconButton Icon="@Icons.Material.Outlined.ViewSidebar" Size="Size.Small" Class="tool-btn mail-hide-phone" aria-label="@Text.ToggleSidebar"
                           OnClick="() => _sidebar = !_sidebar" data-testid="toggle-sidebar" />
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchAsync" Placeholder="@($"{Text.Search}...")" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search" DebounceInterval="300" Immediate="true" Margin="Margin.Dense"
                          Variant="Variant.Outlined" Class="mail-search" data-testid="inbox-search" />
            <MudMenu EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="@(Folder == MailFolder.All ? Text.Categories : Text.Folder(Folder))"
                     Variant="Variant.Text" Dense="true" Class="mail-categories" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     data-testid="categories">
                @foreach (var folder in Enum.GetValues<MailFolder>())
                {
                    <MudMenuItem Href="@FolderHref(folder)" data-testid="category" data-folder="@folder">
                        <div class="@($"menu-folder {(folder == Folder ? "on" : "")}")">
                            <span class="flex-grow-1">@Text.Folder(folder)</span>
                            <span class="menu-count">@Count(folder)</span>
                        </div>
                    </MudMenuItem>
                }
            </MudMenu>
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Class="tool-btn" aria-label="@Text.Refresh"
                           OnClick="ReloadAsync" data-testid="refresh" />
        </div>
        @if (_sending)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
        }
        <div class="mail-scroll mail-rows">
            @if (_emails.Count == 0)
            {
                <p class="mail-empty">@Text.NoEmails</p>
            }
            @foreach (var row in _emails)
            {
                var waiting = row.Reply is { Status: ReplyStatus.Pending } && !Lost(row);
                <a href="@EmailHref(row.Id)" class="@($"mail-row {(row.Id == EmailId ? "selected" : "")}")" data-testid="mail-row" data-subject="@row.Subject">
                    <span class="@($"mail-avatar {Senders.Tint(row.From)}")">@Senders.Initial(row.From)</span>
                    <span class="mail-row-text">
                        <span class="mail-row-line">
                            <span class="mail-sender">@Senders.DisplayName(row.From)</span>
                            @if (waiting)
                            {
                                <span class="mail-dot" title="@Text.ReplyPending"></span>
                            }
                            <span class="mail-date">@Senders.When(row.ReceivedAt, Text.Code)</span>
                        </span>
                        <span class="mail-row-line">
                            <span class="mail-subject">@row.Subject</span>
                            <StatusMark Email="row" Lost="Lost(row)" />
                        </span>
                    </span>
                    @* Where the email and its reply stand, for tests and assistive tech; the row shows it as a mark. *@
                    <span hidden data-testid="email-status" data-status="@row.Status"></span>
                    @if (row.Reply is { } reply && !(Lost(row) && reply.Status == ReplyStatus.Pending))
                    {
                        <span hidden data-testid="reply-status" data-status="@reply.Status" data-edited="@reply.Edited.ToString().ToLowerInvariant()"></span>
                    }
                </a>
            }
        </div>
    </section>

    <section class="@($"mail-panel mail-reader {(Selected is null ? "mail-hide-phone" : "")}")" data-testid="mail-pane">
        <div class="mail-toolbar">
            @if (Selected is { } open)
            {
                <MudIconButton Href="@FolderHref(Folder)" Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="tool-btn mail-show-phone"
                               aria-label="@Text.BackToInbox" />
                <MudIconButton Href="@(Neighbour(-1) is { } previous ? EmailHref(previous.Id) : null)" Disabled="@(Neighbour(-1) is null)"
                               Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Class="tool-btn" aria-label="@Text.Previous" data-testid="previous" />
                <MudIconButton Href="@(Neighbour(1) is { } next ? EmailHref(next.Id) : null)" Disabled="@(Neighbour(1) is null)"
                               Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="tool-btn" aria-label="@Text.Next" data-testid="next" />
                <EmailStatusChip Status="open.Status" Lost="Lost(open)" />
                @if (open.RunId is not null && open.Detail is null)
                {
                    <MudTooltip Text="@Text.WhyItStopped">
                        <MudIconButton Icon="@(_trace ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)" Size="Size.Small"
                                       Class="@($"tool-btn {(_trace ? "on" : "")}")" aria-label="@Text.WhyItStopped" OnClick="() => _trace = !_trace"
                                       data-testid="trace-toggle" />
                    </MudTooltip>
                }
            }
            <span class="flex-grow-1"></span>
        </div>
        @if (Selected is not { } email)
        {
            <div class="mail-placeholder">
                <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" />
                <span>@Text.PickEmail</span>
            </div>
        }
        else
        {
            <div class="mail-scroll mail-read">
                <h1 class="mail-title" data-testid="mail-subject">@email.Subject</h1>
                <div class="mail-tags">
                    <span class="mail-tag-icon"><MudIcon Icon="@Icons.Material.Outlined.SupportAgent" Size="Size.Small" /></span>
                    <span class="mail-tag-sep"></span>
                    @if (email.TicketId is { } ticket)
                    {
                        <span class="mail-tag"><MudIcon Icon="@Icons.Material.Outlined.ConfirmationNumber" Size="Size.Small" />@ticket</span>
                    }
                    <span class="mail-tag">
                        <span class="@($"mail-avatar xs {Senders.Tint(email.From)}")">@Senders.Initial(email.From)</span>@Senders.DisplayName(email.From)
                    </span>
                </div>

                <div class="mail-divider"></div>
                <div class="mail-head">
                    <span class="@($"mail-avatar {Senders.Tint(email.From)}")">@Senders.Initial(email.From)</span>
                    <div class="mail-head-text">
                        <div><span class="mail-head-name">@Senders.DisplayName(email.From)</span> <span class="mail-head-address">&lt;@email.From&gt;</span></div>
                        <div class="mail-head-to">@Text.ToLabel: @email.To</div>
                    </div>
                    <span class="mail-head-time">@Senders.Stamp(email.ReceivedAt, Text.Code)</span>
                </div>
                <div class="mail-body">
                    <p class="draft-text" data-testid="mail-body">@email.Body</p>
                </div>

                @if (email.Status is EmailStatus.NotifyFailed or EmailStatus.Received)
                {
                    <div class="mail-notice error">
                        <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" />
                        <span class="flex-grow-1">@email.Detail</span>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="ghost-btn" StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="() => RetryAsync(email)" data-testid="retry">@Text.Retry</MudButton>
                    </div>
                }
                else if (email.RunId is null || email.Detail is not null)
                {
                    <div class="mail-notice">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                        <span>@email.Detail</span>
                    </div>
                }
                else
                {
                    <MailReply RunId="@email.RunId" Subject="@email.Subject" OnDecided="ReloadAsync" @bind-ShowTrace="_trace" />
                }
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter] public Guid? EmailId { get; set; }

    /// <summary>The category in the URL (?folder=Review), so a link keeps what the list shows.</summary>
    [SupplyParameterFromQuery(Name = "folder")] public string? FolderName { get; set; }

    private MailFolder Folder => Enum.TryParse<MailFolder>(FolderName, true, out var folder) ? folder : MailFolder.All;

    private IReadOnlyList<EmailRowDto> _emails = [];
    private IReadOnlyList<FolderCountDto> _folders = [];
    private MailFolder? _loadedFolder;
    private string? _search;
    private bool _sending;
    private bool _sidebar = true;
    private bool _trace;
    private readonly CancellationTokenSource _stop = new();

    // The open email stays open when a decision moves it out of the category on screen.
    private EmailRowDto? _outside;

    private EmailRowDto? Selected => _emails.FirstOrDefault(e => e.Id == EmailId) ?? (_outside?.Id == EmailId ? _outside : null);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    // A new category in the URL reloads the list; opening another email does not.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFolder is not null && (_loadedFolder != Folder || (EmailId is { } id && Selected is null && _emails.All(e => e.Id != id))))
        {
            await ReloadAsync();
        }
    }

    private string FolderQuery(MailFolder folder) => folder == MailFolder.All ? "" : $"?folder={folder}";

    private string FolderHref(MailFolder folder) => $"inbox{FolderQuery(folder)}";

    private string EmailHref(Guid id) => $"inbox/{id}{FolderQuery(Folder)}";

    private static string FolderIcon(MailFolder folder) => folder switch
    {
        MailFolder.All => Icons.Material.Outlined.Inbox,
        MailFolder.Review => Icons.Material.Outlined.RateReview,
        MailFolder.Agent => Icons.Material.Outlined.AutoAwesome,
        MailFolder.Sent => Icons.Material.Outlined.Send,
        MailFolder.NotSent => Icons.Material.Outlined.Block,
        _ => Icons.Material.Outlined.ErrorOutline,
    };

    private int Count(MailFolder folder) => _folders.FirstOrDefault(f => f.Folder == folder)?.Count ?? 0;

    private EmailRowDto? Neighbour(int step)
    {
        var list = _emails.ToList();
        var at = list.FindIndex(e => e.Id == EmailId) + step;
        return EmailId is null || at < 0 || at >= list.Count ? null : list[at];
    }

    // While an email is still moving (with the agent, waiting for a person), the list reloads every 2 s.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = PollAsync();
        }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (!_sending && _emails.Any(InProgress))
                {
                    await InvokeAsync(ReloadAsync);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    // The Agent API keeps runs in memory: after a restart the email's run is gone and cannot be reviewed.
    private static bool Lost(EmailRowDto e) => e.Status is EmailStatus.Notified or EmailStatus.AwaitingReview && e.Detail is not null;

    private static bool InProgress(EmailRowDto e) =>
        e.Status is EmailStatus.Notified or EmailStatus.AwaitingReview && e.Detail is null;

    private async Task ReloadAsync()
    {
        try
        {
            var folder = Folder;
            var page = await Mailbox.ListAsync(_search, null, true, 0, 50, folder, _stop.Token);
            (_emails, _folders, _loadedFolder) = (page.Items, page.Folders ?? [], folder);
            _outside = EmailId is { } id && _emails.All(e => e.Id != id) ? await Mailbox.GetAsync(id, _stop.Token) : null;
            StateHasChanged();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnSearchAsync(string? value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task ComposeAsync()
    {
        var dialog = await Dialogs.ShowAsync<ComposeEmailDialog>(Text.Compose,
            new DialogParameters<ComposeEmailDialog> { { d => d.Text, Text } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true });
        if (await dialog.Result is not { Canceled: false, Data: ComposeEmailRequest request })
        {
            return;
        }

        _sending = true;
        StateHasChanged();
        EmailRowDto? row = null;
        try
        {
            row = await Mailbox.SubmitAsync(request);
            Snackbar.Add($"{Text.EmailSaved}: {Text.Name(row?.Status ?? EmailStatus.Received)}",
                row?.Status == EmailStatus.NotifyFailed ? Severity.Warning : Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sending = false;
        }

        await ReloadAsync();
        if (row is not null)
        {
            // A new email is always in All.
            Navigation.NavigateTo($"inbox/{row.Id}");
        }
    }

    private async Task RetryAsync(EmailRowDto row)
    {
        await Mailbox.RetryAsync(row.Id);
        await ReloadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _stop.Dispose();
    }
}
