@page "/"
@page "/inbox"
@page "/inbox/{EmailId:guid}"
@implements IAsyncDisposable
@inject MailboxClient Mailbox
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Text.InboxTitle</PageTitle>

@* Laid out like a mail client, in two panels: the list on the left and, on the right, the open
   email with the agent's draft in the reply composer under it. On a phone the two take turns. *@
<div class="mail-shell">
    <MudPaper Outlined="true" Class="@($"mail-panel mail-list {(Selected is null ? "" : "mail-hide-phone")}")" data-testid="inbox">
        <div class="mail-toolbar">
            <MudText Typo="Typo.h6" Class="flex-grow-1">@Text.InboxTitle</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Size="Size.Small"
                       Disabled="_sending" OnClick="ComposeAsync" data-testid="compose">@Text.Compose</MudButton>
        </div>
        <div class="mail-toolbar pt-0">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchAsync" Placeholder="@Text.Search" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300" Immediate="true" Margin="Margin.Dense"
                          Variant="Variant.Outlined" Class="mt-0 flex-grow-1" data-testid="inbox-search" />
            <MudMenu EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="@(Folder == MailFolder.All ? Text.Categories : Text.Folder(Folder))"
                     Variant="Variant.Text" Dense="true" data-testid="categories">
                @foreach (var folder in Enum.GetValues<MailFolder>())
                {
                    <MudMenuItem Href="@FolderHref(folder)" data-testid="category" data-folder="@folder">
                        <div class="d-flex align-center gap-4">
                            <span class="flex-grow-1">@Text.Folder(folder)</span>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Count(folder)</MudText>
                        </div>
                    </MudMenuItem>
                }
            </MudMenu>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" aria-label="@Text.Refresh" OnClick="ReloadAsync" data-testid="refresh" />
        </div>
        @if (_sending)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        <div class="mail-scroll">
            @if (_emails.Count == 0)
            {
                <MudText Class="mud-text-secondary pa-4">@Text.NoEmails</MudText>
            }
            @foreach (var email in _emails)
            {
                var waiting = email.Reply is { Status: ReplyStatus.Pending } && !Lost(email);
                <a href="@EmailHref(email.Id)" class="@($"mail-row {(email.Id == EmailId ? "selected" : "")}")" data-testid="mail-row" data-subject="@email.Subject">
                    <MudAvatar Size="Size.Medium" Variant="Variant.Outlined" Class="mail-avatar">@Initial(email.From)</MudAvatar>
                    <div class="mail-row-text">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.body2" Class="@($"mail-ellipsis {(waiting ? "mail-strong" : "")}")">@email.From</MudText>
                            @if (waiting)
                            {
                                <span class="mail-dot" title="@Text.ReplyPending"></span>
                            }
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary text-nowrap">@When(email.ReceivedAt)</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="@($"mail-ellipsis {(waiting ? "mail-strong" : "")}")">@email.Subject</MudText>
                        <MudText Typo="Typo.caption" Class="mail-ellipsis mud-text-secondary d-block">@email.Body</MudText>
                        <div class="d-flex flex-wrap align-center gap-1 mt-1">
                            <EmailStatusChip Status="email.Status" Lost="Lost(email)" />
                            @* A lost run's reply can no longer be decided: "waiting for a person" would be false. *@
                            @if (email.Reply is { } reply && !(Lost(email) && reply.Status == ReplyStatus.Pending))
                            {
                                <ReplyStatusChip Reply="reply" />
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Class="@($"mail-panel mail-reader {(Selected is null ? "mail-hide-phone" : "")}")" data-testid="mail-pane">
        @if (Selected is not { } email)
        {
            <div class="d-flex flex-column align-center justify-center mud-text-secondary flex-grow-1" style="min-height: 320px">
                <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Large" Class="mb-2" />
                <MudText>@Text.PickEmail</MudText>
            </div>
        }
        else
        {
            <div class="mail-toolbar">
                <MudIconButton Href="@FolderHref(Folder)" Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mail-show-phone"
                               aria-label="@Text.BackToInbox" />
                <MudIconButton Href="@(Neighbour(-1) is { } previous ? EmailHref(previous.Id) : null)" Disabled="@(Neighbour(-1) is null)"
                               Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" aria-label="@Text.Previous" data-testid="previous" />
                <MudIconButton Href="@(Neighbour(1) is { } next ? EmailHref(next.Id) : null)" Disabled="@(Neighbour(1) is null)"
                               Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-label="@Text.Next" data-testid="next" />
                <EmailStatusChip Status="email.Status" Lost="Lost(email)" />
            </div>
            <div class="mail-scroll px-6 pb-6">
                <MudText Typo="Typo.h5" Class="mb-2" data-testid="mail-subject">@email.Subject</MudText>
                <div class="d-flex flex-wrap align-center gap-2 mb-5">
                    @if (email.TicketId is { } ticket)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.ConfirmationNumber">@ticket</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Person">@email.From</MudChip>
                </div>

                <MudDivider Class="mb-4" />
                <div class="d-flex align-center gap-3 mb-3">
                    <MudAvatar Size="Size.Medium" Variant="Variant.Outlined">@Initial(email.From)</MudAvatar>
                    <div class="flex-grow-1 mail-ellipsis">
                        <MudText Typo="Typo.body2"><b>@email.From</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Text.ToLabel: @email.To</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-nowrap">@email.ReceivedAt.ToLocalTime().ToString("dd MMM HH:mm")</MudText>
                </div>
                <div class="mail-body mb-6">
                    <MudText Typo="Typo.body1" Class="draft-text" data-testid="mail-body">@email.Body</MudText>
                </div>

                @if (email.Status is EmailStatus.NotifyFailed or EmailStatus.Received)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@email.Detail</MudAlert>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="() => RetryAsync(email)" data-testid="retry">@Text.Retry</MudButton>
                }
                else if (email.RunId is null || email.Detail is not null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@email.Detail</MudAlert>
                }
                else
                {
                    <MailReply RunId="@email.RunId" Subject="@email.Subject" OnDecided="ReloadAsync" />
                }
            </div>
        }
    </MudPaper>
</div>

@code {
    [CascadingParameter] public Labels Text { get; set; } = Labels.En;

    [Parameter] public Guid? EmailId { get; set; }

    /// <summary>The category in the URL (?folder=Review), so a link keeps what the list shows.</summary>
    [SupplyParameterFromQuery(Name = "folder")] public string? FolderName { get; set; }

    private MailFolder Folder => Enum.TryParse<MailFolder>(FolderName, true, out var folder) ? folder : MailFolder.All;

    private IReadOnlyList<EmailRowDto> _emails = [];
    private IReadOnlyList<FolderCountDto> _folders = [];
    private MailFolder? _loadedFolder;
    private string? _search;
    private bool _sending;
    private readonly CancellationTokenSource _stop = new();

    // The open email stays open when a decision moves it out of the category on screen.
    private EmailRowDto? _outside;

    private EmailRowDto? Selected => _emails.FirstOrDefault(e => e.Id == EmailId) ?? (_outside?.Id == EmailId ? _outside : null);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    // A new category in the URL reloads the list; opening another email does not.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFolder is not null && (_loadedFolder != Folder || (EmailId is { } id && Selected is null && _emails.All(e => e.Id != id))))
        {
            await ReloadAsync();
        }
    }

    private string FolderQuery(MailFolder folder) => folder == MailFolder.All ? "" : $"?folder={folder}";

    private string FolderHref(MailFolder folder) => $"inbox{FolderQuery(folder)}";

    private string EmailHref(Guid id) => $"inbox/{id}{FolderQuery(Folder)}";

    private int Count(MailFolder folder) => _folders.FirstOrDefault(f => f.Folder == folder)?.Count ?? 0;

    private EmailRowDto? Neighbour(int step)
    {
        var list = _emails.ToList();
        var at = list.FindIndex(e => e.Id == EmailId) + step;
        return EmailId is null || at < 0 || at >= list.Count ? null : list[at];
    }

    // While an email is still moving (with the agent, waiting for a person), the list reloads every 2 s.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = PollAsync();
        }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (!_sending && _emails.Any(InProgress))
                {
                    await InvokeAsync(ReloadAsync);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    // The Agent API keeps runs in memory: after a restart the email's run is gone and cannot be reviewed.
    private static bool Lost(EmailRowDto e) => e.Status is EmailStatus.Notified or EmailStatus.AwaitingReview && e.Detail is not null;

    private static bool InProgress(EmailRowDto e) =>
        e.Status is EmailStatus.Notified or EmailStatus.AwaitingReview && e.Detail is null;

    private async Task ReloadAsync()
    {
        try
        {
            var folder = Folder;
            var page = await Mailbox.ListAsync(_search, null, true, 0, 50, folder, _stop.Token);
            (_emails, _folders, _loadedFolder) = (page.Items, page.Folders ?? [], folder);
            _outside = EmailId is { } id && _emails.All(e => e.Id != id) ? await Mailbox.GetAsync(id, _stop.Token) : null;
            StateHasChanged();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnSearchAsync(string? value)
    {
        _search = value;
        await ReloadAsync();
    }

    private async Task ComposeAsync()
    {
        var dialog = await Dialogs.ShowAsync<ComposeEmailDialog>(Text.Compose,
            new DialogParameters<ComposeEmailDialog> { { d => d.Text, Text } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true });
        if (await dialog.Result is not { Canceled: false, Data: ComposeEmailRequest request })
        {
            return;
        }

        _sending = true;
        StateHasChanged();
        EmailRowDto? row = null;
        try
        {
            row = await Mailbox.SubmitAsync(request);
            Snackbar.Add($"{Text.EmailSaved}: {Text.Name(row?.Status ?? EmailStatus.Received)}",
                row?.Status == EmailStatus.NotifyFailed ? Severity.Warning : Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sending = false;
        }

        await ReloadAsync();
        if (row is not null)
        {
            // A new email is always in All.
            Navigation.NavigateTo($"inbox/{row.Id}");
        }
    }

    private async Task RetryAsync(EmailRowDto row)
    {
        await Mailbox.RetryAsync(row.Id);
        await ReloadAsync();
    }

    private static string Initial(string from) => from.Length > 0 ? from[..1].ToUpperInvariant() : "?";

    private static string When(DateTimeOffset at)
    {
        var local = at.ToLocalTime();
        return local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("dd MMM");
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _stop.Dispose();
    }
}
